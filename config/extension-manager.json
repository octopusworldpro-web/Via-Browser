{
  "schemaVersion": 1,
  "product": "OmegA Browser",
  "extensionManager": {
    "enabled": true,
    "disabledReason": "The lightweight content-script runner is available. Each imported extension remains disabled until the user explicitly enables it; scripts run in page context without privileged Chrome APIs.",
    "defaultEnabled": false,
    "permissionPolicy": "explicit_least_privilege",
    "hostAccessModes": [
      "on_click",
      "selected_sites",
      "all_sites"
    ],
    "runtimeStates": [
      "unknown",
      "compatible",
      "partial",
      "incompatible"
    ],
    "lifecycleStates": [
      "staged",
      "rejected",
      "installed_disabled",
      "enabled",
      "error",
      "incompatible",
      "removed"
    ],
    "storage": {
      "metadata": "app_private_database",
      "packages": "app_private_extension_directory",
      "isolatePerExtension": true,
      "storeExecutableBytesInMetadataDb": false
    },
    "security": {
      "executeDuringImport": false,
      "autoGrantPermissions": false,
      "exposeCookiesByDefault": false,
      "exposePasswordsByDefault": false,
      "exposeHistoryByDefault": false,
      "rejectPathTraversal": true,
      "rejectSymlinks": true,
      "requireArchiveLimits": true,
      "requireAtomicUpdates": true
    },
    "runtimeAdapterRequiredForExecution": false,
    "preserveExistingUserscripts": true,
    "noBuiltInExtensionCatalog": true,
    "plannedImportSources": [
      "local_zip",
      "local_crx"
    ],
    "runtimeAvailable": true,
    "chromeExtensionExecution": false,
    "webStoreInstallEnabled": false,
    "webStoreCompatibility": false,
    "engineStrategy": "retain_android_webview",
    "implementationTarget": "limited_page_context_content_scripts",
    "fullChromeExtensionCompatibility": false,
    "geckoViewBundled": false,
    "minSdkPreservationTarget": 19,
    "runtimeAdapterContract": "AUDIT/STEP-07-RUNTIME-IMPLEMENTATION.md",
    "supportedRuntimeFeatures": [
      "manifest_v2_v3_content_scripts",
      "http_https_match_patterns",
      "top_frame_document_idle",
      "manual_enable_disable",
      "per_extension_site_access_blocked_by_default",
      "one_time_current_site_grant",
      "selected_origin_allow_list",
      "all_matching_http_https_sites"
    ],
    "unsupportedRuntimeFeatures": [
      "chrome_apis",
      "background_scripts",
      "mv3_service_workers",
      "isolated_worlds",
      "all_frames",
      "chrome_web_store"
    ]
  },
  "fbStateUtility": {
    "enabled": false,
    "product": "C3C FBState Utility",
    "status": "core_and_app_facing_controller_implemented_android_ui_integration_pending",
    "operations": [
      "manual_import",
      "validate",
      "normalize",
      "manual_export"
    ],
    "acceptedInputs": [
      "user_selected_appstate_json",
      "user_pasted_cookie_header",
      "user_selected_netscape_cookie_file"
    ],
    "exportFormats": [
      "appstate_json",
      "netscape_cookie_file"
    ],
    "facebookDomainScope": [
      "facebook.com",
      ".facebook.com",
      "messenger.com",
      ".messenger.com"
    ],
    "automaticWebViewCookieExtraction": false,
    "backgroundCollection": false,
    "networkUpload": false,
    "cloudSync": false,
    "credentialLogging": false,
    "passwordCollection": false,
    "requireExplicitUserAction": true,
    "requirePerOperationConsent": true,
    "showSessionTokenWarning": true,
    "keepDataInAppPrivateStorage": true,
    "clearTemporaryDataOnExit": true,
    "validateCookieNames": [
      "c_user",
      "xs"
    ],
    "rejectMalformedInput": true,
    "rejectUnsupportedDomains": true,
    "neverBypassSiteAuthentication": true
  },
  "deviceIdentityManager": {
    "enabled": false,
    "status": "core_and_app_facing_controller_implemented_webview_adapter_integration_pending",
    "supportedValues": [
      "userAgent",
      "acceptLanguage",
      "locale",
      "timeZone"
    ],
    "siteScope": "exact_http_https_origins",
    "maxSiteOrigins": 50,
    "hardwareIdentifiersSupported": false,
    "rejectedFields": [
      "imei",
      "meid",
      "serialNumber",
      "androidId",
      "hardwareId",
      "deviceId",
      "advertisingId",
      "fingerprint",
      "macAddress"
    ],
    "requireExplicitUserAction": true,
    "requirePerProfileConsent": true,
    "persistInAppPrivateStorage": true,
    "applyOnlyToBrowserExposedValues": true
  }
}